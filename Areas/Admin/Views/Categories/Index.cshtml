@model IEnumerable<MyStore.Models.EDM.Category>

@{
    ViewBag.Title = "Danh sách danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success" style="padding: 10px; border-radius: 4px;">DANH SÁCH DANH MỤC</h2>

<table class="table bg-info col-md-12">
    <tr>
        <th class="bg-success col-md-8">TÊN DANH MỤC</th>
        <th class="bg-success col-md-4"></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.CategoryName)</td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })
                @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })
            </td>
        </tr>
    }
</table>

<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
    <div class="row mb-3 mt-3">
        <div class="col-md-6">
            @using (Html.BeginForm("Index", "Categories", FormMethod.Get, new { @class = "d-flex" }))
            {
                <input type="text" name="searchTerm" class="form-control me-2" placeholder="Nhập tên danh mục cần tìm..." value="@Request.QueryString["searchTerm"]" />
                <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            }
        </div>
    </div>
</p>