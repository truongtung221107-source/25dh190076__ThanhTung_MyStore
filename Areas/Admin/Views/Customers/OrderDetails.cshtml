@model MyStore.Models.EDM.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
}

<h2 class="my-3">Chi tiết đơn hàng #@Model.OrderID</h2>

<div class="mb-3">
    <p><strong>Khách hàng:</strong> @Model.Customer.CustomerName</p>
    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
    <p><strong>Thanh toán:</strong> @Model.PaymentStatus</p>
    <p><strong>Địa chỉ giao hàng:</strong> @Model.AddressDelivery</p>
</div>

<table class="table table-bordered">
    <thead class="table-info">
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.OrderDetails)
        {
            <tr>
                <td>@d.Product.ProductName</td>
                <td>@d.Quantity</td>
                <td>@d.UnitPrice.ToString("N0") đ</td>
                <td>@((d.Quantity * d.UnitPrice).ToString("N0")) đ</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Tổng cộng</th>
            <th>@Model.TotalAmount.ToString("N0") đ</th>
        </tr>
    </tfoot>
</table>

@Html.ActionLink("Quay lại khách hàng", "Details", "Customers", new { id = Model.CustomerID }, new { @class = "btn btn-secondary" })