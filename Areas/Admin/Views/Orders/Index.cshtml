@model PagedList.IPagedList<MyStore.Models.EDM.Order>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Danh sách đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>DANH SÁCH ĐƠN HÀNG</h2>

@using (Html.BeginForm("Index", "Orders", FormMethod.Get, new { @class = "row g-3 mb-4 mt-2" }))
{
    <div class="col-md-4">
        <label class="form-label fw-bold">Tên khách hàng / Mã đơn</label>
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Nhập tên khách hoặc mã đơn..." />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold">Trạng thái thanh toán</label>
        @Html.DropDownList("paymentStatus", (SelectList)ViewBag.PaymentStatusList, "-- Tất cả --", new { @class = "form-select" })
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold">Ngày đặt hàng</label>
        <input type="date" name="orderDate" value="@ViewBag.OrderDate" class="form-control" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning text-center fw-bold">KHÔNG CÓ</div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="table-success">
            <tr>
                <th>Mã đơn</th>
                <th>Ngày đặt hàng</th>
                <th>Tên khách hàng</th>
                <th>Tổng giá trị</th>
                <th>Trạng thái thanh toán</th>
                <th>Phương thức giao hàng</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>#@item.OrderID</td>
                    <td>@String.Format("{0:dd/MM/yyyy}", item.OrderDate)</td>
                    <td>@item.Customer.CustomerName</td>
                    <td>@String.Format("{0:N0} đ", item.TotalAmount)</td>
                    <td>@item.PaymentStatus</td>
                    <td>@item.DeliveryMethod</td>
                    <td>
                        @Html.ActionLink("Chi tiết đơn hàng", "Details", new { id = item.OrderID })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        @Html.PagedListPager(Model, page => Url.Action("Index", new
        {
            page,
            searchTerm = ViewBag.SearchTerm,
            paymentStatus = ViewBag.PaymentStatus,
            orderDate = ViewBag.OrderDate
        }))
    </div>
}