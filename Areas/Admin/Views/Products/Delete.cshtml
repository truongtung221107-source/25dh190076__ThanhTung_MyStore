@model MyStore.Models.EDM.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success" style="padding: 10px; border-radius: 4px;">XÓA SẢN PHẨM</h2>
<h4 class="alert-danger" style="padding: 10px;">Bạn thực sự muốn xóa sản phẩm này à?</h4>

@Html.Partial("PVProductInfo", Model)

<br />
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-actions no-color">
        <div class="col-md-offset-3 col-md-9">
            <input type="submit" value="Xóa" class="btn btn-primary" />
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
        </div>
    </div>
}