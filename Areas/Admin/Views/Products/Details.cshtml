@model MyStore.Models.EDM.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success" style="padding: 10px; border-radius: 4px;">CHI TIẾT SẢN PHẨM</h2>

@Html.Partial("PVProductInfo", Model)

<br />
<div class="form-group">
    <div class="col-md-offset-3 col-md-9">
        @Html.ActionLink("Sửa", "Edit", new { id = Model.ProductID }, new { @class = "btn btn-primary" })
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
    </div>
</div>