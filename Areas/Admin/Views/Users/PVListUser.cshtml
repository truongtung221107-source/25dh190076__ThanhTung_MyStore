@model MyStore.Models.ViewModel.UserSearchVM
@using PagedList.Mvc;

<table class="table table-bordered table-striped">
    <thead class="bg-info">
        <tr>
            <th>Tên đăng nhập</th>
            <th>Vai trò (Role)</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Users != null && Model.Users.Any())
        {
            foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>@user.UserRole</td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit", new { id = user.Username }, new { @class = "btn btn-sm btn-primary" })
                        @Html.ActionLink("Xóa", "Delete", new { id = user.Username }, new { @class = "btn btn-sm btn-danger" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">Không tìm thấy tài khoản nào.</td>
            </tr>
        }
    </tbody>
</table>

<p>
    @Html.ActionLink("Thêm tài khoản mới", "Create", null, new { @class = "btn btn-success" })
</p>

<div>
    Trang @(Model.Users.PageCount < Model.Users.PageNumber ? 0 : Model.Users.PageNumber) / @Model.Users.PageCount
    @Html.PagedListPager(Model.Users, page => Url.Action("Index", new { page, sortOrder = Model.SortOrder, searchTerm = Model.SearchTerm }))
</div>
