@model IEnumerable<MyStore.Models.CartItem>

@{
    ViewBag.Title = "Giỏ hàng của bạn";
}

<div class="container" style="margin-top: 30px;">
    <h2>Giỏ hàng mua sắm</h2>
    <hr />

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="width: 100px;">
                            @if (!string.IsNullOrEmpty(item.ProductImage))
                            {
                                <img src="@Url.Content(item.ProductImage)" style="width: 80px; height: 80px; object-fit: cover;" />
                            }
                        </td>
                        <td style="vertical-align: middle;">@item.ProductName</td>
                        <td style="vertical-align: middle;">@string.Format("{0:N0} VNĐ", item.ProductPrice)</td>
                        <td style="vertical-align: middle;">@item.Quantity</td>
                        <td style="vertical-align: middle; color: #e74c3c; font-weight: bold;">@string.Format("{0:N0} VNĐ", item.TotalPrice)</td>
                        <td style="vertical-align: middle;">
                            @Html.ActionLink("Xóa", "RemoveFromCart", new { id = item.ProductID }, new { @class = "btn btn-danger btn-sm" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-right" style="margin-top: 20px;">
            <h3>Tổng tiền thanh toán: <span style="color: #e74c3c;">@string.Format("{0:N0} VNĐ", ViewBag.Total)</span></h3>
            <br />
            @Html.ActionLink("Tiếp tục mua sắm", "Index", "Home", null, new { @class = "btn btn-secondary" })
            <a href="@Url.Action("Checkout", "Cart")" class="btn btn-success btn-lg">Tiến hành đặt hàng</a>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" style="padding: 40px;">
            <h4>Giỏ hàng của bạn đang trống!</h4>
            <p>Hãy quay lại trang chủ để chọn mua những sản phẩm ưng ý nhé.</p>
            @Html.ActionLink("Về trang chủ", "Index", "Home", null, new { @class = "btn btn-primary" })
        </div>
    }
</div>