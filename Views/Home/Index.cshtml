@model IEnumerable<MyStore.Models.EDM.Product>

@{
    ViewBag.Title = "Trang chủ";
}

<div class="jumbotron text-center" style="background: #f8f9fa; padding: 40px; margin-top: 20px; border-radius: 8px;">
    <h1>CHÀO MỪNG ĐẾN VỚI CỬA HÀNG</h1>
    <p class="lead">Khám phá các sản phẩm chất lượng cao với giá tốt nhất ngay hôm nay!</p>

    <!-- Ô tìm kiếm nhanh cho khách -->
    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
    {
        <div class="form-inline justify-content-center" style="margin-top: 20px;">
            @Html.TextBox("searchString", ViewBag.SearchString as string, new { @class = "form-control", @placeholder = "Nhập tên sản phẩm cần tìm...", @style = "width: 350px; display: inline-block; margin-right: 10px;" })
            <input type="submit" value="Tìm kiếm" class="btn btn-primary" />
        </div>
    }
</div>

<hr />

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3" style="margin-bottom: 30px;">
            <div class="card h-100" style="border: 1px solid #ddd; border-radius: 8px; padding: 15px; text-align: center; background: #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">

                <!-- Hình ảnh sản phẩm -->
                <div style="height: 180px; display: flex; align-items: center; justify-content: center; overflow: hidden; margin-bottom: 15px;">
                    @if (!string.IsNullOrEmpty(item.ProductImage))
                    {
                        <img src="@Url.Content(item.ProductImage)" style="max-height: 180px; max-width: 100%; object-fit: cover; border-radius: 4px;" />
                    }
                    else
                    {
                        <span class="text-muted">Không có ảnh</span>
                    }
                </div>

                <!-- Tên sản phẩm -->
                <h4 style="font-size: 18px; font-weight: bold; height: 45px; overflow: hidden; margin-bottom: 10px;">
                    @item.ProductName
                </h4>

                <!-- Giá tiền -->
                <p style="color: #e74c3c; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
                    @string.Format("{0:N0} VNĐ", item.ProductPrice)
                </p>

                <!-- Nút xem chi tiết -->
                <div>
                    @Html.ActionLink("Xem chi tiết", "Details", "Home", new { id = item.ProductID }, new { @class = "btn btn-outline-info btn-sm", @style = "width: 100%;" })
                </div>
            </div>
        </div>
    }
</div>