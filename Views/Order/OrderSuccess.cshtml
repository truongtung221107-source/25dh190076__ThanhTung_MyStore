@model MyStore.Models.EDM.Order
@{
    ViewBag.Title = "Đặt hàng thành công";
}

<h2 class="text-success">ĐẶT HÀNG THÀNH CÔNG</h2>

<p>Mã đơn hàng: <strong>@Model.OrderID</strong></p>
<p>Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy")</p>
<p>Trạng thái thanh toán: @Model.PaymentStatus</p>
<p>Hình thức thanh toán: @Model.PaymentMethod</p>
<p>Hình thức giao hàng: @Model.DeliveryMethod</p>
<p>Địa chỉ giao hàng: @Model.ShippingAddress</p>

<table class="table">
    <thead>
        <tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr>
    </thead>
    <tbody>
        @foreach (var d in Model.OrderDetails)
        {
            <tr>
                <td>@d.Product.ProductName</td>
                <td>@d.Quantity</td>
                <td>@d.UnitPrice.ToString("N0")</td>
                <td>@((d.Quantity * d.UnitPrice).ToString("N0"))</td>
            </tr>
        }
    </tbody>
</table>

<p>Tổng cộng: <strong>@Model.TotalAmount.ToString("N0") đ</strong></p>

@Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-warning" })